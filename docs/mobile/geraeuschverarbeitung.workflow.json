  "cards": [
    {
      "dot": "violet",
      "title": "Wann bleibt es eine Phase?",
      "items": [
        "Sprache: Pause ≤ 90 s, lückenlos analysiert. Vor Wiederbeginn ≥ 20 % Sprachaktivität im Rückblick von bis zu 5 min. Sonst neuer Block."
      ]
    },
    {
      "dot": "emerald",
      "title": "Beispiel · Diktieren",
      "items": [
        "40 s Sprache → 20 s Denkpause → 30 s Sprache: ein Block von 90 s, davon 70 s aktiv. Ohne Analyse in der Pause: zwei Blöcke."
      ]
    },
    {
      "dot": "amber",
      "title": "Was bedeutet die Quelle?",
      "items": [
        "Sprache ist ein Modellhinweis. Der Pegel gilt für die gesamte Szene. Inhalt, Sprecher und persönliche Belästigung bleiben offen."
